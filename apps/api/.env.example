# ── App ───────────────────────────────────────────────────────────────────────
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-replace-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://copilot:changeme@localhost:5432/cloud_posture

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for rate limiting and job queue in production.
# Leave blank to fall back to in-memory mode (dev/test only).
REDIS_URL=redis://localhost:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AWS ───────────────────────────────────────────────────────────────────────
# In production, attach an IAM role to your compute instance and leave blank.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_STS_SESSION_DURATION=3600

# ── AI (Anthropic) ────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...your-key-here...
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=1024
AI_ENABLED=true
